<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.option.mapper.OptionMemberProfileMapper">

    <resultMap type="OptionMemberProfile" id="OptionMemberProfileResult">
        <id     property="userId"                column="user_id"               />
        <result property="watchSymbols"          column="watch_symbols"         />
        <result property="strategyPreferences"   column="strategy_preferences"  />
        <result property="strongAlerts"          column="strong_alerts"         />
        <result property="version"               column="version"               />
        <result property="createTime"            column="create_time"           />
        <result property="createTimeUtc"         column="create_time_utc"       />
        <result property="updateTime"            column="update_time"           />
        <result property="updateTimeUtc"         column="update_time_utc"       />
    </resultMap>

    <sql id="selectOptionMemberProfileVo">
        select user_id, watch_symbols, strategy_preferences, strong_alerts, version, create_time, create_time_utc, update_time, update_time_utc
        from option_member_profile
    </sql>

    <select id="selectOptionMemberProfileList" parameterType="OptionMemberProfile" resultMap="OptionMemberProfileResult">
        <include refid="selectOptionMemberProfileVo"/>
        <where>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="strongAlerts != null and strongAlerts != ''">and strong_alerts = #{strongAlerts}</if>
            <if test="version != null">and version = #{version}</if>
        </where>
        order by user_id
    </select>

    <select id="selectOptionMemberProfileById" parameterType="Long" resultMap="OptionMemberProfileResult">
        <include refid="selectOptionMemberProfileVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertOptionMemberProfile" parameterType="OptionMemberProfile">
        insert into option_member_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="watchSymbols != null and watchSymbols != ''">watch_symbols,</if>
            <if test="strategyPreferences != null and strategyPreferences != ''">strategy_preferences,</if>
            <if test="strongAlerts != null and strongAlerts != ''">strong_alerts,</if>
            create_time,
            create_time_utc,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="watchSymbols != null and watchSymbols != ''">#{watchSymbols},</if>
            <if test="strategyPreferences != null and strategyPreferences != ''">#{strategyPreferences},</if>
            <if test="strongAlerts != null and strongAlerts != ''">#{strongAlerts},</if>
            date_add(utc_timestamp(), interval 8 hour),
            utc_timestamp(),
        </trim>
    </insert>

    <update id="updateOptionMemberProfile" parameterType="OptionMemberProfile">
        update option_member_profile
        <set>
            <if test="watchSymbols != null">watch_symbols = #{watchSymbols},</if>
            <if test="strategyPreferences != null">strategy_preferences = #{strategyPreferences},</if>
            <if test="strongAlerts != null">strong_alerts = #{strongAlerts},</if>
            version = version + 1,
            update_time = date_add(utc_timestamp(), interval 8 hour),
            update_time_utc = utc_timestamp(),
        </set>
        where user_id = #{userId} and version = #{version}
    </update>

    <delete id="deleteOptionMemberProfileById" parameterType="Long">
        delete from option_member_profile where user_id = #{userId}
    </delete>

    <delete id="deleteOptionMemberProfileByIds">
        delete from option_member_profile where user_id in
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

</mapper>
